    "@nestjs/core": "^10.4.4",
    "@nestjs/mongoose": "^10.0.10",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/platform-socket.io": "^10.4.4",
    "@nestjs/websockets": "^10.4.4",
    "@react-pdf/renderer": "^3.4.5",
    "bullmq": "^5.13.2",
    "ioredis": "^5.4.1",
    "mongoose": "^8.7.0",
    "openai": "^4.67.3",
    "pdf-parse": "^1.1.1",
    "react": "^18.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.0",
    "zod": "^3.23.8"

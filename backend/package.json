{
  "name": "vedaai-backend",
  "version": "1.0.0",
  "description": "VedaAI — scalable NestJS backend for async AI assessment generation",
  "author": "VedaAI",
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",

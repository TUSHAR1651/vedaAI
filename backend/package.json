    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@nestjs/bullmq": "^10.2.1",
    "@nestjs/common": "^10.4.4",

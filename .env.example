# ============================================================
# VedaAI — Environment Variables
# Copy to `.env` at the repo root (used by docker-compose) and
# into backend/.env / frontend/.env.local for local dev.
# ============================================================

# ---------- Backend: Server ----------
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed CORS / Socket.io origins
CORS_ORIGIN=http://localhost:3000

# ---------- MongoDB ----------
# Local dev: mongodb://localhost:27017/vedaai
# Docker:    mongodb://mongo:27017/vedaai
MONGO_URI=mongodb://localhost:27017/vedaai

# ---------- Redis (BullMQ + caching + status) ----------
# Local dev: localhost / 6379
# Docker:    redis / 6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- docker-compose host port mappings ----------
# Override these if the standard ports are already in use on your machine.
# They only affect the HOST side of the mapping (containers always use the
# standard ports internally). If you change REDIS_PORT_HOST and run the
# backend OUTSIDE Docker, set REDIS_PORT (above) to match.
MONGO_PORT_HOST=27017
REDIS_PORT_HOST=6379

# ---------- AI Provider ----------
# Which provider the GenerationModule uses: "openai" | "gemini" | "mock"
# "mock" returns deterministic structured JSON with NO API key required —
# perfect for local demos and tests.
AI_PROVIDER=mock

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini
GEMINI_API_KEY=
# `gemini-1.5-flash` was retired — use `gemini-2.5-flash` (or `gemini-flash-latest`).
GEMINI_MODEL=gemini-2.5-flash

# Max times the worker retries the *whole* AI call when Zod validation fails
AI_MAX_VALIDATION_RETRIES=2

# ---------- File storage (generated PDFs) ----------
# Path inside the backend container / process where PDFs are written.
STORAGE_DIR=./storage
# Public base URL the frontend uses to download generated PDFs.
PUBLIC_BASE_URL=http://localhost:4000

# ---------- Frontend (Next.js) ----------
# These are read at build/run time by the Next.js app.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
